{
  "name": "animato-koor",
  "version": "1.0.0",
  "type": "module",
  "description": "Moderne koorwebsite voor Gemengd Koor Animato met ledenportaal, agenda, ticketing en SATB materiaalmodule",
  "scripts": {
    "dev": "vite",
    "dev:cloud": "WRANGLER_DEV_CONFIG=wrangler.dev.json vite --port 3000 --host 0.0.0.0",
    "dev:sandbox": "wrangler pages dev dist --d1=animato-production --local --ip 0.0.0.0 --port 3000",
    "check:dates": "node scripts/check-naive-dates.mjs",
    "check:dates:list": "node scripts/check-naive-dates.mjs --list",
    "check:dates:update-baseline": "node scripts/check-naive-dates.mjs --update-baseline",
    "prebuild": "node scripts/check-naive-dates.mjs && npm run build:css",
    "build:css": "tailwindcss -i src/tailwind-input.css -o public/static/css/tailwind.css --minify",
    "build:css:watch": "tailwindcss -i src/tailwind-input.css -o public/static/css/tailwind.css --watch",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name animato-koor",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl http://localhost:3000",
    "db:create": "wrangler d1 create animato-production",
    "db:migrate:local": "wrangler d1 migrations apply animato-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply animato-production",
    "db:seed": "wrangler d1 execute animato-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "db:console:local": "wrangler d1 execute animato-production --local",
    "db:console:prod": "wrangler d1 execute animato-production",
    "git:init": "git init && git add . && git commit -m 'Initial commit'",
    "git:commit": "git add . && git commit -m",
    "git:status": "git status",
    "git:log": "git log --oneline"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hono": "^4.10.5",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251111.0",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/qrcode": "^1.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
