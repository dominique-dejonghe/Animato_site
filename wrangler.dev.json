{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "animato-live",
  "compatibility_date": "2025-11-11",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "animato-production",
      "database_id": "758eef10-f55b-428f-81ca-4d7f87862811"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "animato-storage"
    }
  ],
  "vars": {
    "JWT_SECRET": "dev-local-jwt-secret-change-me",
    "SITE_URL": "http://localhost:3000",
    "RESEND_API_KEY": "dev-placeholder",
    "OPENAI_API_KEY": "dev-placeholder",
    "CRON_SECRET": "dev-local-cron-secret"
  }
}
